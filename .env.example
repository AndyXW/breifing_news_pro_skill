# A 股投研参考 Pro - 环境变量配置模板
# 复制此文件为 .env 并填入你的真实配置

# ========== 必需配置 ==========

# Tavily Search API Key
# 用于新闻搜索和数据聚合
# 获取地址：https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# ========== AI 配置（可选） ==========

# DeepSeek AI API Key（可选）
# 如果不配置，将使用 OpenClaw 内置 AI 能力
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ========== 可选配置 ==========

# 飞书用户 ID（用于推送消息）
# 格式：ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 如果不配置，简报将只输出到控制台
FEISHU_USER_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书机器人 App ID（用于发送消息）
# 如果不配置，将使用 OpenClaw 默认飞书配置
FEISHU_APP_ID=cli_xxxxxxxxxxxxx

# 飞书机器人 App Secret
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========== 高级配置（可选） ==========

# DeepSeek API 基础 URL（默认：https://api.deepseek.com/v1）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# AI 模型名称（默认：deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat

# 最大生成字数（默认：1500）
# MAX_WORDS=1500

# 搜索模块数量限制（默认：6 个模块，每个最多 15 条）
# MAX_NEWS_PER_MODULE=15

# AI 处理新闻条数上限（默认：80 条）
# MAX_AI_PROCESS=80
